<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      双目标说明：
      - netstandard2.0：供 .NET Framework 4.7.2 等老工程引用（SqlSugar 5.0.x 系列要求，
        SqlSugarCore 从 5.0.3 起仅支持 netstandard2.1，5.0.2.9 是最后一个兼容 2.0 的版本）；
      - netstandard2.1：供 net6/net8 等新工程引用，使用新版 SqlSugarCore。
      两套目标框架下公共 API（Queryable/Insertable/Updateable/Deleteable/SugarColumn）完全一致。
    -->
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>MRedisCache</RootNamespace>
    <Description>MRedisCache：三级缓存（内存 / Redis / 数据库）中间件，数据库层基于 SqlSugar ORM</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.7.10" />
    <PackageReference Include="System.Threading.Channels" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="SqlSugarCore" Version="5.0.2.9" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
  </ItemGroup>

</Project>
